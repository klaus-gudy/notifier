PORT=

NOTIFY_BASE_URL=https://api.notify.africa/api/v1
NOTIFY_API_KEY=
NOTIFY_SENDER_ID=

NOTIFY_TIMEOUT_MS=
NOTIFY_MAX_ATTEMPTS=
NOTIFY_POLL_ENABLED=
NOTIFY_POLL_CRON=*/1 * * * *
NOTIFY_POLL_BATCH_SIZE=
NOTIFY_POLL_MAX_AGE_HOURS=
# Delivery-status polling.
# Logs full request bodies (phone numbers + message text) to the terminal.
LOG_REQUEST_BODY=


# Either set DATABASE_URL on its own, or the five discrete fields below.
# When DATABASE_URL is set it wins and the others are ignored.
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/notifier
DATABASE_HOST=
DATABASE_PORT=
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_NAME=

# Optional — sensible defaults are applied when these are left unset.


RESEND_API_KEY=
RESEND_SENDER_EMAIL=
RESEND_SENDER_NAME=

# Queue consumers for inbound email and SMS events. Both queues are declared
# by the producer; this service only checks they exist and consumes them.
RABBITMQ_URL=
RABBITMQ_ENABLED=
RABBITMQ_EMAIL_QUEUE=
RABBITMQ_SMS_QUEUE=
RABBITMQ_PREFETCH=

# Only read by `npm run queue:setup`, which declares the SMS queue, its
# dead-letter queue and their bindings. The app never reads this.
RABBITMQ_SMS_EXCHANGE=
